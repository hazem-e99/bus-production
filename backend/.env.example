# Backend production environment
NODE_ENV=production
PORT=7126

# Bind to loopback only — Nginx reverse-proxies to this port, it must never
# be reachable directly from outside the server.
HOST=127.0.0.1

# Local MongoDB on VPS (dedicated app user, not the Mongo superadmin)
MONGODB_URI=mongodb://127.0.0.1:27017/bus-system
DB_NAME=bus-system

# Security
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRATION=7d

# CORS: comma-separated allowed origins (same-origin in production since
# Nginx serves frontend and proxies /api on el-renad.com, this is mainly
# for direct API testing/tools)
CORS_ORIGIN=https://el-renad.com,https://www.el-renad.com,http://localhost:3000

# Uploads folder — points at a symlink into persistent storage
# (/var/lib/elrenad/uploads) so redeploys never lose uploaded files.
UPLOAD_DIR=./uploads

# Mail settings (required for verification-code and password-reset emails).
# Uses Gmail SMTP via nodemailer's "gmail" service — MAIL_USER must be a full
# Gmail/Workspace address and MAIL_PASS a 16-character Google App Password
# (not the account login password; requires 2-Step Verification on the
# account). See docs/email-deliverability.md for SPF/DKIM/DMARC guidance.
MAIL_USER=
MAIL_PASS=

# Optional — display name shown as the email sender. Defaults to "El Renad".
MAIL_FROM_NAME=El Renad

# Optional — Reply-To address for outgoing mail. Defaults to MAIL_USER.
MAIL_REPLY_TO=
