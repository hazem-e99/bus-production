# El Renad Bus System - Nginx reverse proxy
# Regenerated by deploy/deploy.sh on every run from this template.
# Manual edits here will be overwritten on the next deploy — edit
# deploy/nginx/el-renad.conf.template instead. (certbot will append its own
# SSL server blocks below on first successful certificate issuance; those
# ARE preserved since deploy.sh only overwrites this file before SSL is
# configured, never after.)

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Canonical host: www redirects to the apex domain. Uses $scheme (not a
# hardcoded http://) so that once Certbot attaches a certificate to this
# same block, the redirect goes straight to https://el-renad.com instead of
# bouncing through HTTP first.
server {
    listen 80;
    listen [::]:80;
    server_name @@DOMAIN_WWW@@;
    return 301 $scheme://@@DOMAIN_PRIMARY@@$request_uri;
}

server {
    listen 80;
    listen [::]:80;
    server_name @@DOMAIN_PRIMARY@@;

    client_max_body_size 25m;

    # Never serve dotfiles (.env, .git, etc.)
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    gzip_min_length 1024;

    # Next.js's own image proxy route (frontend/src/app/api/image-proxy) —
    # more specific than the /api/ block below, so nginx's longest-prefix
    # match routes it to the frontend instead of the backend even though it
    # also lives under /api/.
    location /api/image-proxy {
        proxy_pass http://127.0.0.1:@@FRONTEND_PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Backend REST API
    location /api/ {
        proxy_pass http://127.0.0.1:@@BACKEND_PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Uploaded files (profile pictures) served by the backend
    location /uploads/ {
        proxy_pass http://127.0.0.1:@@BACKEND_PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "public, max-age=86400";
    }

    # Socket.IO - live bus tracking (WebSocket upgrade)
    location /socket.io/ {
        proxy_pass http://127.0.0.1:@@BACKEND_PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    # Everything else - the Next.js app
    location / {
        proxy_pass http://127.0.0.1:@@FRONTEND_PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
