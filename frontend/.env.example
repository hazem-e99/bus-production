# Frontend production environment
NODE_ENV=production

# Public app URL (used in reset-password links)
NEXT_PUBLIC_APP_URL=https://el-renad.com

# Backend API URL and origin — same domain as the frontend. Nginx proxies
# /api, /socket.io and /uploads on el-renad.com straight to the backend,
# so there is no cross-origin request in production.
NEXT_PUBLIC_API_BASE_URL=https://el-renad.com/api
NEXT_PUBLIC_BACKEND_ORIGIN=https://el-renad.com

# Optional
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_CURRENCY=EGP
